def out(s):
    sys.stdout.write(s)
    sys.exit(0)


def j(obj):
    out(json.dumps(obj, ensure_ascii=False))


if 'graphql' in A:
    sys.stderr.write('graphql disabled in demo\n')
    sys.exit(1)

if ARGS[:2] == ['api', 'user']:
    out('yamada-taro\n')

if ARGS[0] == 'api' and '/releases' in ARGS[1]:
    j(RELEASES)

if ARGS[0] == 'api' and 'collaborators' in ARGS[1]:
    out('["yamada-taro","suzuki-ichiro","sato-jiro","tanaka-hanako"]')

if ARGS[0] == 'api' and '/compare/' in ARGS[1]:
    out(C_V11 if H_21 in ARGS[1] or H_22 in ARGS[1] else C_V10)

if ARGS[0] == 'api' and '/commits/' in ARGS[1]:
    out(C_V11 if 'v1.1' in ARGS[1] else C_V10)

if ARGS[0] == 'api' and '--jq' in ARGS and '.permissions.push' in A:
    out('true')

if ARGS[0] == 'api' and '/pulls/' in ARGS[1] and 'reviews' in ARGS[1]:
    n = 21 if '/pulls/21/' in ARGS[1] else 22
    j((PR21 if n == 21 else PR22)['reviews'])

if ARGS[0] == 'issue' and ARGS[1] == 'list':
    out('[]')

if ARGS[0] == 'pr' and ARGS[1] == 'list':
    if '--state' in ARGS and ARGS[ARGS.index('--state') + 1] == 'merged':
        j(MERGED)
    j([PR21, PR22])

if ARGS[0] == 'pr' and ARGS[1] == 'view':
    n = int(ARGS[2])
    j(PR21 if n == 21 else PR22)

if ARGS[0] == 'pr' and ARGS[1] == 'diff':
    out('')

# それ以外の書き込み系は成功したふりだけする (デモでは何も起きない)
out('')
